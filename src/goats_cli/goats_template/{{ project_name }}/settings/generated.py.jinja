"""
Generated settings for GOATS.

This file is created automatically by the GOATS installer. It contains machine-specific
or environment-specific values.

Do not edit this file manually unless you know what you're doing.

For local overrides, use local.py instead.
"""

from pathlib import Path

SECRET_KEY = "{{ secret_key }}"
"""Secret key for Django."""

REDIS_HOST = "{{ redis_host }}"
"""Hostname of the Redis server."""

REDIS_PORT = {{ redis_port }}
"""Port of the Redis server."""

MEDIA_ROOT = Path("{{ media_root }}")
"""Filesystem path to the media directory."""

TARGET_TYPE = "{{ target_type }}"
"""Type of deployment target."""

HINTS_ENABLED = {{ hints_enabled }}
"""Whether hints are enabled."""

CREATE_DATE = "{{ create_date }}"
"""Date when the installation was created."""

GOATS_DB_ENGINE = "{{ db_engine }}"
"""Database backend chosen at install time: "sqlite" or "postgres".

Written here rather than left to the environment so the choice survives: this
file is created once by the installer and never overwritten, so a GOATS
installed against PostgreSQL stays that way in any shell, with no variables to
remember. The GOATS_DB_* environment variables still override these values when
set -- see base.py."""

GOATS_DB_NAME = "{{ db_name }}"
"""Database name. Blank means the default SQLite file inside the project."""

GOATS_DB_USER = "{{ db_user }}"
"""Database user. Unused by SQLite."""

GOATS_DB_PASSWORD = "{{ db_password }}"
"""Database password. Unused by SQLite."""

GOATS_DB_HOST = "{{ db_host }}"
"""Database host. Unused by SQLite."""

GOATS_DB_PORT = "{{ db_port }}"
"""Database port. Unused by SQLite."""

GOATS_STREAM_EXECUTOR = "{{ stream_executor }}"
"""Where ANTARES stream consumption runs: "local" or "datalab".

Written here for the same reason as GOATS_DB_ENGINE, and with one difference
that matters: there is no environment variable behind this setting. Every
consumer reads it off `settings` with `getattr` -- see
`goats_tom.executors.resolve_executor_name` -- and nothing calls `os.getenv`
for it, so exporting GOATS_STREAM_EXECUTOR in a shell has no effect. A
settings file is the only place it can be set.

"local" runs consumers on this host and is the desktop default; the hard
invariant is that a desktop install behaves exactly as before when this is
"local" or absent. "datalab" launches them in each PI's Astro Data Lab
notebook server instead.

`getattr` with a default is used throughout precisely so a generated.py
written before this key existed keeps working."""
